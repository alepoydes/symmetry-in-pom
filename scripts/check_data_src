#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
source_root="$root/data_src"

require_file() {
  if [[ ! -s "$1" ]]; then
    printf 'missing or empty source file: %s\n' "$1" >&2
    exit 1
  fi
}

require_file "$source_root/experiment.toml"
require_file "$source_root/checksums.sha256"

for wavelength_nm in 450 520 660; do
  for acquisition in {1..9}; do
    require_file \
      "$source_root/holography/$wavelength_nm/$acquisition.npz"
  done
  count=$(find "$source_root/holography/$wavelength_nm" -maxdepth 1 \
    -type f -name '*.npz' | wc -l)
  if [[ "$count" -ne 9 ]]; then
    printf 'expected 9 Jones archives at %s nm, found %s\n' \
      "$wavelength_nm" "$count" >&2
    exit 1
  fi
done

for exposure_ms in 12 42; do
  directory="$source_root/direct_pom/520nm/Exposure_${exposure_ms}ms"
  require_file "$directory/Environment.png"
  for frame in 0045 0046 0047 0048 0049; do
    require_file "$directory/$frame.png"
  done
  for ground in {1..9}; do
    require_file "$directory/Ground ($ground).png"
  done
  numbered_count=$(find "$directory" -maxdepth 1 -type f \
    -name '[0-9][0-9][0-9][0-9].png' | wc -l)
  if [[ "$numbered_count" -ne 5 ]]; then
    printf 'expected 5 numbered POM frames at %s ms, found %s\n' \
      "$exposure_ms" "$numbered_count" >&2
    exit 1
  fi
  png_count=$(find "$directory" -maxdepth 1 -type f -name '*.png' | wc -l)
  if [[ "$png_count" -ne 15 ]]; then
    printf 'expected 15 total POM PNG files at %s ms, found %s\n' \
      "$exposure_ms" "$png_count" >&2
    exit 1
  fi
done

source_file_count=$(find "$source_root/holography" "$source_root/direct_pom" -type f | wc -l)
if [[ "$source_file_count" -ne 57 ]]; then
  printf 'expected exactly 57 experimental payload files, found %s\n' \
    "$source_file_count" >&2
  exit 1
fi

(
  cd "$root"
  sha256sum --check --quiet data_src/checksums.sha256
)
cd "$root"
uv run python "$root/code/scripts/validate_source_data.py" --experimental

printf 'Experimental inputs are complete: 27 Jones fields and 5 dual-exposure POM states.\n'
